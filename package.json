{
  "name": "jdeploy-test-app",
  "version": "1.0.20",
  "description": "Test application for jDeploy publishing",
  "bin": {
    "jdeploy-test-app": "jdeploy-bundle/jdeploy.js"
  },
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shannah/jdeploy-test-app.git"
  },
  "jdeploy": {
    "jdk": false,
    "javaVersion": "11",
    "javafx": false,
    "jar": "target/jdeploy-test-app-1.0.20.jar",
    "title": "jDeploy Test App",
    "appUpdateMode": "prompt",
    "publishTargets": [
      {
        "name": "github: shannah/jdeploy-test-app",
        "type": "GITHUB",
        "url": "https://github.com/shannah/jdeploy-test-app"
      }
    ]
  },
  "dependencies": {
    "command-exists-promise": "^2.0.2",
    "node-fetch": "2.6.7",
    "tar": "^4.4.8",
    "yauzl": "^2.10.0",
    "shelljs": "^0.8.4"
  },
  "files": [
    "jdeploy-bundle"
  ],
  "license": "ISC"
}
